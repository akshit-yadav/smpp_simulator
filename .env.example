# Copy to .env (never commit .env).  `make env` copies this file and fills the
# secrets below with random values.

PSG_VERSION=dev
PSG_LOG_LEVEL=info

# ---- Control plane (psg-control) -------------------------------------------
# 127.0.0.1 keeps the panel/API local. Use 0.0.0.0 when workers run on other
# hosts, and firewall the port.
PSG_HTTP_HOST=127.0.0.1
PSG_HTTP_PORT=8080
PSG_AUTO_MIGRATE=true
# AES-256-GCM key for gateway passwords: 32 random bytes, base64 (openssl rand -base64 32)
PSG_SECRET_KEY=__generate__
# Shared token for the worker -> control internal API (openssl rand -hex 32)
PSG_INTERNAL_TOKEN=__generate__
# Initial admin account, used only when no admin exists yet.
PSG_ADMIN_USERNAME=admin
PSG_ADMIN_PASSWORD=__generate__

# ---- Worker (psg-worker) ----------------------------------------------------
# 8-bit worker ID (0-255); unique per worker. It is part of every message ID.
PSG_WORKER_ID=1
# IP shown on gateways. Empty = the IP of the interface carrying the default route.
PSG_WORKER_IP=
PSG_WORKER_METRICS_ADDR=127.0.0.1:9108
PSG_CONTROL_URL=http://127.0.0.1:8080
PSG_PORT_RANGE=20000-20999
# Comma-separated ports and ranges to never use, e.g. 20022,20500-20510
PSG_PORT_EXCLUDE=
# Gateways come from the control plane. To run a worker without it, point this
# at a static file instead (e.g. /etc/psg/gateways.json, mounted from ./config).
PSG_GATEWAYS_FILE=
# Last config received from the control plane; served if it is down at startup.
PSG_CONFIG_CACHE=/var/lib/psg/config-cache.json
# Interface the SMPP listeners bind to. Empty = all interfaces.
PSG_LISTEN_HOST=
PSG_SPILL_DIR=/var/lib/psg/spill
PSG_SPILL_MAX_BYTES=5368709120

# ---- MariaDB -----------------------------------------------------------------
# Defaults point at the bundled profile. For a MariaDB already on the host, set
# its host/port/credentials here and run without --profile bundled.
PSG_MARIADB_HOST=127.0.0.1
PSG_MARIADB_PORT=13306
PSG_MARIADB_DATABASE=psg
PSG_MARIADB_USER=psg
PSG_MARIADB_PASSWORD=__generate__

# ---- Redis -------------------------------------------------------------------
PSG_REDIS_HOST=127.0.0.1
PSG_REDIS_PORT=16379
PSG_REDIS_PASSWORD=__generate__
PSG_REDIS_DB=0

# ---- ClickHouse ----------------------------------------------------------------
PSG_CLICKHOUSE_HOST=127.0.0.1
PSG_CLICKHOUSE_HTTP_PORT=18123
PSG_CLICKHOUSE_NATIVE_PORT=19000
PSG_CLICKHOUSE_DATABASE=psg
PSG_CLICKHOUSE_USER=psg
PSG_CLICKHOUSE_PASSWORD=__generate__

# ---- Bundled profile only ------------------------------------------------------
BUNDLED_MARIADB_ROOT_PASSWORD=__generate__
