# Copy to .env (never commit .env).  `make env` copies this file and fills the
# secrets below with random values.

FSG_VERSION=dev
FSG_LOG_LEVEL=info

# ---- Control plane (fsg-control) -------------------------------------------
# 127.0.0.1 keeps the panel/API local. Use 0.0.0.0 when workers run on other
# hosts, and firewall the port.
FSG_HTTP_HOST=127.0.0.1
FSG_HTTP_PORT=8080
FSG_AUTO_MIGRATE=true
# AES-256-GCM key for gateway passwords: 32 random bytes, base64 (openssl rand -base64 32)
FSG_SECRET_KEY=__generate__
# Shared token for the worker -> control internal API (openssl rand -hex 32)
FSG_INTERNAL_TOKEN=__generate__
# Initial admin account, used only when no admin exists yet.
FSG_ADMIN_USERNAME=admin
FSG_ADMIN_PASSWORD=__generate__

# ---- Worker (fsg-worker) ----------------------------------------------------
# 8-bit worker ID (0-255); unique per worker. It is part of every message ID.
FSG_WORKER_ID=1
# IP shown on gateways. Empty = the IP of the interface carrying the default route.
FSG_WORKER_IP=
FSG_WORKER_METRICS_ADDR=127.0.0.1:9108
FSG_CONTROL_URL=http://127.0.0.1:8080
FSG_PORT_RANGE=20000-20999
# Comma-separated ports and ranges to never use, e.g. 20022,20500-20510
FSG_PORT_EXCLUDE=
# Static gateway file (mounted from ./config); the control plane replaces it in M3.
FSG_GATEWAYS_FILE=/etc/fsg/gateways.json
# Interface the SMPP listeners bind to. Empty = all interfaces.
FSG_LISTEN_HOST=
FSG_SPILL_DIR=/var/lib/fsg/spill
FSG_SPILL_MAX_BYTES=5368709120

# ---- MariaDB -----------------------------------------------------------------
# Defaults point at the bundled profile. For a MariaDB already on the host, set
# its host/port/credentials here and run without --profile bundled.
FSG_MARIADB_HOST=127.0.0.1
FSG_MARIADB_PORT=13306
FSG_MARIADB_DATABASE=fsg
FSG_MARIADB_USER=fsg
FSG_MARIADB_PASSWORD=__generate__

# ---- Redis -------------------------------------------------------------------
FSG_REDIS_HOST=127.0.0.1
FSG_REDIS_PORT=16379
FSG_REDIS_PASSWORD=__generate__
FSG_REDIS_DB=0

# ---- ClickHouse ----------------------------------------------------------------
FSG_CLICKHOUSE_HOST=127.0.0.1
FSG_CLICKHOUSE_HTTP_PORT=18123
FSG_CLICKHOUSE_NATIVE_PORT=19000
FSG_CLICKHOUSE_DATABASE=fsg
FSG_CLICKHOUSE_USER=fsg
FSG_CLICKHOUSE_PASSWORD=__generate__

# ---- Bundled profile only ------------------------------------------------------
BUNDLED_MARIADB_ROOT_PASSWORD=__generate__
